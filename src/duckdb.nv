// duckdb.nv — the whole public surface of this package.
//
// Source: subplan 01.4 §4 of claude-limits.
//
// THIS IS NOT A COMPLETE BINDING OF DUCKDB, and the README says so in the same
// words. Version 0.1 gives Nova a finished core plus what the first consumer needs;
// anything else is added minor version by minor version when a consumer appears —
// without rebuilding the library, because the static archive already contains
// everything (§4.1). A request to widen it is an issue naming the consumer and the
// function, not a "while we are here".
//
// ── Handles are `consume`, and that is the safety story ─────────────────────
//
// `Database`, `Connection`, `Result`, `Statement` and `Appender` are `consume`
// types. Closing one takes it by value, so using it afterwards is a COMPILE error
// rather than a use-after-free — the class of bug that a C database binding
// otherwise hands to every caller. Nothing here hands out a raw handle: `ffi.nv` is
// module-private and its types never appear in an exported signature.
//
// ── Failure ─────────────────────────────────────────────────────────────────
//
// Every fallible call carries `Fail[DuckError]` and throws. The message comes from
// DuckDB itself, copied out immediately — the pointer it hands back dies on the
// next call against the same handle.

module duckdb

// ── Why every `ffi` call below sits in `unsafe { }` ─────────────────────────
//
// An extern that takes a pointer is `#unsafe fn`, and the obligation has to be
// discharged somewhere rather than propagated. Here is that somewhere: this file
// knows the pointers came from the shim, that they outlive the call, and that the
// lengths beside them are the lengths the shim measured. That knowledge is exactly
// what the wrap asserts, and discharging it here is what lets every EXPORTED
// signature in this package be safe -- a consumer of `nova-duckdb` never writes
// `unsafe` and never holds a raw handle.
//
// Only the calls that actually take or return a RAW pointer are wrapped. A call
// whose arguments are handles and integers is not `#unsafe fn`, and wrapping it is
// its own error (`E_UNSAFE_UNUSED`) -- the checker refuses a wrap that guards
// nothing, which is a good rule: a decorative `unsafe` teaches a reader to stop
// noticing them.
//
// Only the calls that actually take or return a RAW pointer are wrapped. A call
// whose arguments are handles and integers is not `#unsafe fn`, and wrapping it is
// its own error (`E_UNSAFE_UNUSED`) -- the checker refuses a wrap that guards
// nothing, which is a good rule: a decorative `unsafe` teaches a reader to stop
// noticing them.
//

import duckdb.ffi
// Constants BY NAME: a module-qualified constant compiles to `ffi->NAME` and the
// checker accepts it silently. Functions through the prefix are fine.
import duckdb.ffi.{DDB_E_APPEND, DDB_E_BIND, DDB_E_CLOSED, DDB_E_OPEN, DDB_E_PREPARE, DDB_E_QUERY, DDB_E_TYPE, DDB_OK, KIND_APPENDER, KIND_CONN, KIND_DB, KIND_RESULT, KIND_STMT}
import duckdb.types.{LogicalType, Value, DecimalValue, logical_type_of, str_of_raw, bytes_of_raw, timestamp_of_micros, micros_of_timestamp, date_of_epoch_days, time_of_micros}
// `Timestamp` and `Uuid` are named in the binding signatures below, so they come
// back in; the conversions themselves still live in `types.nv`.
import std.time.duration.{Timestamp}
import std.identifiers.uuid.{Uuid}

/// What went wrong. One variant per shim error code, so a caller can match
/// exhaustively and a new code cannot arrive unnoticed.
export type DuckError enum
    | Open(str)
    | Query(str)
    | Prepare(str)
    | Bind(str)
    | Append(str)
    /// A column of a type 0.1 does not read (§4.1), or a value that cannot cross
    /// faithfully — a sub-microsecond instant, an interval carrying months.
    | Type(str)
    | Closed

export fn DuckError @message() -> str {
    match @ {
        DuckError.Open(m) => m
        DuckError.Query(m) => m
        DuckError.Prepare(m) => m
        DuckError.Bind(m) => m
        DuckError.Append(m) => m
        DuckError.Type(m) => m
        DuckError.Closed => "handle already closed"
    }
}

/// How to open a database.
///
/// `DbOptions` AND NOT `OpenOptions`, which is what it was called first:
/// `std/fs/fs.nv` exports an `OpenOptions` of its own, and a consumer with both in
/// one compilation unit gets `redefinition of 'NovaValue_OpenOptions'` from clang
/// while `nova check` stays green. Third carrier of that class in this package
/// alone (registry 1040).
///
/// The defaults are the ones 01.2 §3.1 asks a consumer to use, so a caller that
/// does not care gets the right thing: two threads and half a gigabyte, which is
/// what a desktop application polling an endpoint every five minutes needs.
export type DbOptions value {
    read_only bool
    /// DuckDB's own spelling, e.g. "512MB".
    memory_limit str
    threads int
    /// Where DuckDB spills. Empty means beside the database file. It is NEVER
    /// `~/.duckdb` — the shim always sets this, so a stray directory cannot appear
    /// in a person's home (01.2 §0а).
    temp_dir str
    /// 32 bytes for AES-256-GCM, or empty for an unencrypted file. The key is not
    /// stored anywhere by this package.
    encryption_key str
}

export fn DbOptions.defaults() -> DbOptions =>
    { read_only: false, memory_limit: "512MB", threads: 2, temp_dir: "", encryption_key: "" }

// ── handles ──────────────────────────────────────────────────────────────────

export type Database consume { ro h ffi.CDbHandle }
export type Connection consume { ro h ffi.CConnHandle }
export type QueryResult consume { ro h ffi.CResultHandle }

// ── errors from DuckDB ───────────────────────────────────────────────────────

fn message_of(handle *(), kind int) -> str {
    mut len = 0
    ro p = unsafe { ffi.ddb_last_error(handle, kind, &len) }
    ro m = str_of_raw(p, len)
    if m == "" { "duckdb reported no message" } else { m }
}

/// Turn a shim code plus a handle into the error to throw.
///
/// The code decides the VARIANT and the handle supplies the TEXT. Keeping them
/// apart is what lets a caller switch on the kind of failure while still showing a
/// person what the engine actually said.
fn error_of(code int, handle *(), kind int) -> DuckError {
    ro m = message_of(handle, kind)
    if code == DDB_E_OPEN { return DuckError.Open(m) }
    if code == DDB_E_QUERY { return DuckError.Query(m) }
    if code == DDB_E_PREPARE { return DuckError.Prepare(m) }
    if code == DDB_E_BIND { return DuckError.Bind(m) }
    if code == DDB_E_APPEND { return DuckError.Append(m) }
    if code == DDB_E_TYPE { return DuckError.Type(m) }
    if code == DDB_E_CLOSED { return DuckError.Closed }
    DuckError.Query(m)
}

// ── database ─────────────────────────────────────────────────────────────────

/// Open a database file, or `":memory:"`.
export fn Database.open(path str, opts DbOptions) Fail[DuckError] -> Database {
    ro pb = path.bytes()
    ro tb = opts.temp_dir.bytes()
    ro mb = opts.memory_limit.bytes()
    ro kb = opts.encryption_key.bytes()
    mut err = 0
    ro ro_flag = if opts.read_only { 1 } else { 0 }
    ro h = unsafe { ffi.ddb_open(pb.ptr(), pb.len(), tb.ptr(), tb.len(), mb.ptr(), mb.len(), opts.threads, ro_flag, kb.ptr(), kb.len(), &err) }
    if err != DDB_OK { throw DuckError.Open(message_of(h as *(), KIND_DB)) }
    { h }
}

/// An in-memory database. Everything the tests use, and nothing on disk.
export fn Database.open_memory(opts DbOptions) Fail[DuckError] -> Database =>
    Database.open(":memory:", opts)

export fn Database @connect() Fail[DuckError] -> Connection {
    mut err = 0
    ro c = unsafe { ffi.ddb_connect(@h, &err) }
    if err != DDB_OK { throw error_of(err, @h as *(), KIND_DB) }
    { h: c }
}

export fn Database consume @close() -> () {
    ffi.ddb_close(@h)
}

/// `Cleanup` (D188/D194), which is what makes `consume x = ... { ... }` legal on
/// this type. Without it the scope form is refused and every consumer is pushed
/// back to a bare `consume` plus a manual close on every path -- including the
/// paths a failure takes, which are the ones people forget.
export fn Database consume @cleanup(outcome ScopeOutcome) -> () => @close()

/// The DuckDB version this package was built against, e.g. `"v1.5.5"`.
export fn Database.version() -> str {
    ro p = unsafe { ffi.ddb_version() }
    // The shim hands back a NUL-terminated literal from static storage; the length
    // is found by scanning, once, at a call site nobody puts in a loop.
    mut n = 0
    while n < 64 {
        if unsafe { p.offset(n).read() } == 0 { break }
        n += 1
    }
    str_of_raw(p, n)
}

/// The extensions compiled in. Statically linked, never loaded at runtime — a
/// binary that reaches the network for an extension is the failure 01.2 §0а
/// measured at twenty-two seconds.
export fn Database.extensions() -> []str => ["core_functions", "icu"]

// ── connection ───────────────────────────────────────────────────────────────

/// Run a statement and report rows changed.
export fn Connection @exec(sql str) Fail[DuckError] -> int {
    ro b = sql.bytes()
    mut changed i64 = 0
    ro rc = unsafe { ffi.ddb_exec(@h, b.ptr(), b.len(), &changed) }
    if rc != DDB_OK { throw error_of(rc, @h as *(), KIND_CONN) }
    changed as int
}

/// Run a query and materialise the result.
export fn Connection @query(sql str) Fail[DuckError] -> QueryResult {
    ro b = sql.bytes()
    mut err = 0
    ro r = unsafe { ffi.ddb_query(@h, b.ptr(), b.len(), &err) }
    if err != DDB_OK { throw error_of(err, @h as *(), KIND_CONN) }
    { h: r }
}

export fn Connection @begin() Fail[DuckError] -> () {
    ro _ = @exec("BEGIN TRANSACTION")
}

export fn Connection @commit() Fail[DuckError] -> () {
    ro _ = @exec("COMMIT")
}

export fn Connection @rollback() Fail[DuckError] -> () {
    ro _ = @exec("ROLLBACK")
}

export fn Connection consume @close() -> () {
    ffi.ddb_disconnect(@h)
}

export fn Connection consume @cleanup(outcome ScopeOutcome) -> () => @close()

// ── result ───────────────────────────────────────────────────────────────────

/// One column of a result.
export type Column value { name str, kind LogicalType }

export fn QueryResult @rows() -> int => ffi.ddb_result_rows(@h) as int
export fn QueryResult @cols() -> int => ffi.ddb_result_cols(@h) as int

export fn QueryResult @column(i int) -> Column {
    mut len = 0
    ro p = unsafe { ffi.ddb_result_col_name(@h, i as i64, &len) }
    { name: str_of_raw(p, len), kind: logical_type_of(ffi.ddb_result_col_type(@h, i as i64)) }
}

export fn QueryResult @columns() -> []Column {
    mut out = []Column.new()
    mut i = 0
    while i < @cols() {
        out.push(@column(i))
        i += 1
    }
    out
}

export fn QueryResult @is_null(row int, col int) -> bool =>
    ffi.ddb_value_is_null(@h, row as i64, col as i64) != 0

/// One value, in whatever shape its column has.
///
/// The column's type decides the shape, not the caller: asking for an `i64` from a
/// `VARCHAR` column is a mistake this design cannot express. A caller that knows
/// its schema matches on the result; one that does not can look at `@column(i)`
/// first.
export fn QueryResult @value(row int, col int) Fail[DuckError] -> Value {
    if @is_null(row, col) { return Value.Null }
    ro r = row as i64
    ro c = col as i64
    match @column(col).kind {
        LogicalType.Boolean => {
            mut v = 0
            ro rc = unsafe { ffi.ddb_value_bool(@h, r, c, &v) }
            if rc != DDB_OK { throw error_of(rc, @h as *(), KIND_RESULT) }
            Value.Bool(v != 0)
        }
        LogicalType.TinyInt => Value.Int(@read_i64(r, c))
        LogicalType.SmallInt => Value.Int(@read_i64(r, c))
        LogicalType.Integer => Value.Int(@read_i64(r, c))
        LogicalType.BigInt => Value.Int(@read_i64(r, c))
        LogicalType.UTinyInt => Value.UInt(@read_u64(r, c))
        LogicalType.USmallInt => Value.UInt(@read_u64(r, c))
        LogicalType.UInteger => Value.UInt(@read_u64(r, c))
        LogicalType.UBigInt => Value.UInt(@read_u64(r, c))
        LogicalType.HugeInt => {
            mut hi i64 = 0
            mut lo u64 = 0
            ro rc = unsafe { ffi.ddb_value_hugeint(@h, r, c, &hi, &lo) }
            if rc != DDB_OK { throw error_of(rc, @h as *(), KIND_RESULT) }
            Value.Huge(hi, lo)
        }
        LogicalType.Float => Value.Real(@read_f64(r, c))
        LogicalType.Double => Value.Real(@read_f64(r, c))
        LogicalType.Decimal => {
            mut hi i64 = 0
            mut lo u64 = 0
            mut scale = 0
            ro rc = unsafe { ffi.ddb_value_decimal(@h, r, c, &hi, &lo, &scale) }
            if rc != DDB_OK { throw error_of(rc, @h as *(), KIND_RESULT) }
            Value.Dec(DecimalValue.of(hi, lo, scale))
        }
        LogicalType.Varchar => Value.Text(@read_text(r, c))
        LogicalType.Enum => Value.Text(@read_text(r, c))
        LogicalType.Blob => {
            mut len = 0
            // The BLOB accessor, not the text one: the text accessor converts a
            // value to a rendering, which for bytes is not the bytes.
            ro p = unsafe { ffi.ddb_value_blob(@h, r, c, &len) }
            Value.Bytes(bytes_of_raw(p, len))
        }
        LogicalType.Timestamp => Value.Instant(timestamp_of_micros(@read_micros(r, c)))
        LogicalType.TimestampTz => Value.Instant(timestamp_of_micros(@read_micros(r, c)))
        LogicalType.Date => {
            mut d i32 = 0
            ro rc = unsafe { ffi.ddb_value_date(@h, r, c, &d) }
            if rc != DDB_OK { throw error_of(rc, @h as *(), KIND_RESULT) }
            Value.Day(date_of_epoch_days(d))
        }
        LogicalType.Time => {
            mut us i64 = 0
            ro rc = unsafe { ffi.ddb_value_time(@h, r, c, &us) }
            if rc != DDB_OK { throw error_of(rc, @h as *(), KIND_RESULT) }
            Value.TimeOfDay(time_of_micros(us))
        }
        LogicalType.Interval => {
            mut months i32 = 0
            mut days i32 = 0
            mut us i64 = 0
            ro rc = unsafe { ffi.ddb_value_interval(@h, r, c, &months, &days, &us) }
            if rc != DDB_OK { throw error_of(rc, @h as *(), KIND_RESULT) }
            // Months are refused rather than approximated: a month is not a fixed
            // number of days, so folding one into a `Duration` moves a date by up
            // to three days depending on when it is applied.
            if months != 0 { throw DuckError.Type("column ${col} is an INTERVAL carrying months, which Duration cannot hold") }
            Value.Span(time_of_micros(us + (days as i64) * 86_400_000_000))
        }
        LogicalType.Uuid => throw DuckError.Type("column ${col}: UUID reading arrives with stage S1")
        LogicalType.SqlNull => Value.Null
        LogicalType.Unsupported => throw DuckError.Type("column ${col} has a type this binding does not read (LIST, STRUCT, MAP, ARRAY, UNION or BIT); see the package README")
    }
}

fn QueryResult @read_i64(r i64, c i64) Fail[DuckError] -> i64 {
    mut v i64 = 0
    ro rc = unsafe { ffi.ddb_value_i64(@h, r, c, &v) }
    if rc != DDB_OK { throw error_of(rc, @h as *(), KIND_RESULT) }
    v
}

fn QueryResult @read_u64(r i64, c i64) Fail[DuckError] -> u64 {
    mut v u64 = 0
    ro rc = unsafe { ffi.ddb_value_u64(@h, r, c, &v) }
    if rc != DDB_OK { throw error_of(rc, @h as *(), KIND_RESULT) }
    v
}

fn QueryResult @read_f64(r i64, c i64) Fail[DuckError] -> f64 {
    mut v = 0.0
    ro rc = unsafe { ffi.ddb_value_f64(@h, r, c, &v) }
    if rc != DDB_OK { throw error_of(rc, @h as *(), KIND_RESULT) }
    v
}

fn QueryResult @read_micros(r i64, c i64) Fail[DuckError] -> i64 {
    mut v i64 = 0
    ro rc = unsafe { ffi.ddb_value_timestamp(@h, r, c, &v) }
    if rc != DDB_OK { throw error_of(rc, @h as *(), KIND_RESULT) }
    v
}

fn QueryResult @read_text(r i64, c i64) -> str {
    mut len = 0
    ro p = unsafe { ffi.ddb_value_bytes(@h, r, c, &len) }
    str_of_raw(p, len)
}

export fn QueryResult consume @close() -> () {
    ffi.ddb_result_free(@h)
}

export fn QueryResult consume @cleanup(outcome ScopeOutcome) -> () => @close()

// ── prepared statements ──────────────────────────────────────────────────────
//
// `@bind` takes this package's own `Value`, not `std/data/sql.nv`'s `SqlValue`.
// The adapter between the two lives in `sqltag.nv`, so that a caller who wants the
// `sql`-tag ergonomics gets them while this file stays free of a dependency it does
// not need to do its job. One sum, one place that knows how each variant reaches
// DuckDB.

export type Statement consume { ro h ffi.CStmtHandle }

/// Prepare a statement. Placeholders are `?`, numbered from one, as DuckDB counts
/// them.
export fn Connection @prepare(text str) Fail[DuckError] -> Statement {
    ro b = text.bytes()
    mut err = 0
    ro st = unsafe { ffi.ddb_prepare(@h, b.ptr(), b.len(), &err) }
    if err != DDB_OK { throw error_of(err, @h as *(), KIND_CONN) }
    { h: st }
}

/// How many placeholders this statement has. A caller binding a list can compare
/// before it starts, which turns a silent under-bind into a named error.
export fn Statement @param_count() -> int => ffi.ddb_stmt_param_count(@h) as int

/// Bind every parameter, in order.
///
/// ALL OR NOTHING, and the count is checked FIRST. DuckDB leaves an unbound
/// parameter as NULL, so a list one short does not fail — it silently writes a NULL
/// into a column that was supposed to get a value. That is the kind of defect that
/// shows up as a hole in a chart three weeks later.
export fn Statement @bind(args []Value) Fail[DuckError] -> () {
    ro want = @param_count()
    if args.len() != want {
        throw DuckError.Bind("statement takes ${want} parameters, ${args.len()} given")
    }
    mut i = 1
    for v in args {
        @bind_one(i as i64, v)
        i += 1
    }
}

fn Statement @bind_one(i i64, v Value) Fail[DuckError] -> () {
    ro rc = match v {
        Value.Null => ffi.ddb_bind_null(@h, i)
        Value.Bool(b) => ffi.ddb_bind_bool(@h, i, if b { 1 } else { 0 })
        Value.Int(n) => ffi.ddb_bind_i64(@h, i, n)
        Value.UInt(n) => ffi.ddb_bind_u64(@h, i, n)
        Value.Huge(hi, lo) => ffi.ddb_bind_hugeint(@h, i, hi, lo)
        Value.Real(x) => ffi.ddb_bind_f64(@h, i, x)
        Value.Dec(d) => ffi.ddb_bind_decimal(@h, i, d.hi, d.lo, d.scale)
        Value.Text(t) => bind_bytes_of(@h, i, t.bytes(), 0)
        Value.Bytes(b) => bind_bytes_of(@h, i, b, 1)
        Value.Instant(t) => bind_instant(@h, i, t)
        Value.Day(d) => ffi.ddb_bind_date(@h, i, d.epoch_day() as i32)
        Value.TimeOfDay(d) => ffi.ddb_bind_time(@h, i, d.micros())
        Value.Span(d) => ffi.ddb_bind_time(@h, i, d.micros())
        Value.Ident(u) => bind_uuid(@h, i, u)
    }
    if rc != DDB_OK { throw error_of(rc, @h as *(), KIND_STMT) }
}

// Hoisted so the `match` arms above stay single expressions: a match in statement
// position whose arms call a chainable method is a codegen defect in this compiler
// (claude-limits probes/match-stmt-chainable-mut), and keeping every arm a plain
// call sidesteps the whole family.
fn bind_bytes_of(h ffi.CStmtHandle, i i64, b []u8, is_blob int) -> int =>
    unsafe { ffi.ddb_bind_bytes(h, i, b.ptr(), b.len(), is_blob) }

fn bind_instant(h ffi.CStmtHandle, i i64, t Timestamp) Fail[DuckError] -> int {
    match micros_of_timestamp(t) {
        Some(us) => ffi.ddb_bind_timestamp(h, i, us)
        None => throw DuckError.Type("a Timestamp with sub-microsecond precision cannot be stored: DuckDB counts microseconds")
    }
}

fn bind_uuid(h ffi.CStmtHandle, i i64, u Uuid) -> int {
    ro b = uuid_bytes(u)
    unsafe { ffi.ddb_bind_uuid(h, i, b.ptr()) }
}

/// A UUID as sixteen bytes, most significant first -- the order the shim expects
/// and the order the textual form reads in.
fn uuid_bytes(u Uuid) -> []u8 {
    mut out = []u8.new(cap: 16)
    ro hi = u.hi()
    ro lo = u.lo()
    mut i = 0
    while i < 8 {
        out.push(((hi >> ((56 - 8 * i) as u64)) & 0xff) as u8)
        i += 1
    }
    i = 0
    while i < 8 {
        out.push(((lo >> ((56 - 8 * i) as u64)) & 0xff) as u8)
        i += 1
    }
    out
}

export fn Statement @execute() Fail[DuckError] -> QueryResult {
    mut err = 0
    ro r = unsafe { ffi.ddb_stmt_execute(@h, &err) }
    if err != DDB_OK { throw error_of(err, @h as *(), KIND_STMT) }
    { h: r }
}

/// Forget the bound parameters, keeping the plan. The point of preparing once and
/// running many times.
export fn Statement @clear() Fail[DuckError] -> () {
    ro rc = ffi.ddb_stmt_clear(@h)
    if rc != DDB_OK { throw error_of(rc, @h as *(), KIND_STMT) }
}

export fn Statement consume @finalize() -> () {
    ffi.ddb_stmt_free(@h)
}

export fn Statement consume @cleanup(outcome ScopeOutcome) -> () => @finalize()

// ── appender ─────────────────────────────────────────────────────────────────
//
// THE ONLY FAST WAY IN. A row at a time through `INSERT` costs about two
// milliseconds in DuckDB; a hundred thousand rows through the appender cost about
// ten milliseconds in total (spike, 2026-09-06). Anything writing a time series
// uses this and nothing else.

export type Appender consume { ro h ffi.CAppHandle }

/// Open an appender on a table. An empty `schema` means the default one.
export fn Connection @appender(schema str, table str) Fail[DuckError] -> Appender {
    ro sb = schema.bytes()
    ro tb = table.bytes()
    mut err = 0
    ro a = unsafe { ffi.ddb_appender_create(@h, sb.ptr(), sb.len(), tb.ptr(), tb.len(), &err) }
    if err != DDB_OK { throw error_of(err, @h as *(), KIND_CONN) }
    { h: a }
}

/// Append one row and end it.
///
/// The row is ended even when a value fails, and that is deliberate: DuckDB's
/// appender holds partial row state, and leaving half a row in it makes every
/// SUBSEQUENT row land in the wrong columns. Failing loudly on a row boundary is
/// recoverable; failing in the middle is not.
export fn Appender @row(values []Value) Fail[DuckError] -> () {
    mut failure = ""
    for v in values {
        ro rc = @append_one(v)
        if rc != DDB_OK && failure == "" { failure = message_of(@h as *(), KIND_APPENDER) }
    }
    ro end_rc = ffi.ddb_append_end_row(@h)
    if failure != "" { throw DuckError.Append(failure) }
    if end_rc != DDB_OK { throw error_of(end_rc, @h as *(), KIND_APPENDER) }
}

fn Appender @append_one(v Value) Fail[DuckError] -> int {
    match v {
        Value.Null => ffi.ddb_append_null(@h)
        Value.Bool(b) => ffi.ddb_append_bool(@h, if b { 1 } else { 0 })
        Value.Int(n) => ffi.ddb_append_i64(@h, n)
        Value.UInt(n) => ffi.ddb_append_u64(@h, n)
        Value.Huge(hi, lo) => ffi.ddb_append_hugeint(@h, hi, lo)
        Value.Real(x) => ffi.ddb_append_f64(@h, x)
        // DECIMAL has no appender entry point in the C API; the exact value goes in
        // as its unscaled integer, which is what the column stores anyway.
        Value.Dec(d) => ffi.ddb_append_hugeint(@h, d.hi, d.lo)
        Value.Text(t) => append_bytes_of(@h, t.bytes(), 0)
        Value.Bytes(b) => append_bytes_of(@h, b, 1)
        Value.Instant(t) => append_instant(@h, t)
        Value.Day(d) => ffi.ddb_append_date(@h, d.epoch_day() as i32)
        Value.TimeOfDay(d) => ffi.ddb_append_time(@h, d.micros())
        Value.Span(d) => ffi.ddb_append_time(@h, d.micros())
        Value.Ident(u) => append_uuid(@h, u)
    }
}

fn append_bytes_of(h ffi.CAppHandle, b []u8, is_blob int) -> int =>
    unsafe { ffi.ddb_append_bytes(h, b.ptr(), b.len(), is_blob) }

fn append_instant(h ffi.CAppHandle, t Timestamp) Fail[DuckError] -> int {
    match micros_of_timestamp(t) {
        Some(us) => ffi.ddb_append_timestamp(h, us)
        None => throw DuckError.Type("a Timestamp with sub-microsecond precision cannot be stored: DuckDB counts microseconds")
    }
}

fn append_uuid(h ffi.CAppHandle, u Uuid) -> int {
    ro b = uuid_bytes(u)
    unsafe { ffi.ddb_append_uuid(h, b.ptr()) }
}

/// Make what has been appended visible to this connection, keeping the appender
/// open.
export fn Appender @flush() Fail[DuckError] -> () {
    ro rc = ffi.ddb_appender_flush(@h)
    if rc != DDB_OK { throw error_of(rc, @h as *(), KIND_APPENDER) }
}

/// Flush and destroy. Fallible, because the flush can fail and dropping that on the
/// floor would lose rows a caller believes are written.
export fn Appender consume @close() Fail[DuckError] -> () {
    ro rc = ffi.ddb_appender_close(@h)
    if rc != DDB_OK { throw DuckError.Append("closing the appender failed; rows may not have been written") }
}

/// The appender's cleanup is the one that CAN fail, and its type says so. A flush
/// that did not land means rows the caller believes are written are not, and
/// swallowing that on the way out of a scope turns lost data into silence.
export fn Appender consume @cleanup(outcome ScopeOutcome) Fail[DuckError] -> () => @close()

// sqltag.nv — the bridge from `sql`…`` to this package's parameters.
//
// Source: subplan 01.4 §4 ("`sqltag.nv` адаптер std/data/sql: Sql -> (text,
// []SqlValue) -> bind").
//
// ── Why a separate file, and why the facade does not import it ──────────────
//
// `std/data/sql.nv` gives a caller `sql\`SELECT … WHERE id = ${x}\``, which builds a
// template with `?` placeholders and a list of arguments beside it — the whole
// point being that a value never becomes part of the text, so injection is not a
// thing that can happen. That is worth having, and it is also a dependency the
// binding itself does not need: `duckdb.nv` speaks its own `Value` and knows
// nothing about `Sql`.
//
// Keeping the adapter here means a consumer who wants the tag gets it, a consumer
// who does not is not made to link it, and the CONVERSION between the two value
// vocabularies lives in exactly one place instead of being re-decided per call
// site.
//
// ── The one asymmetry, said out loud ────────────────────────────────────────
//
// `SqlValue` names one variant per numeric type (registry 221.1 №1637, owner
// 2026-10-02): `Int`, `I8`..`I64`, `U8`..`U32`, `F32`, `F64`, plus `Text`,
// `Bool`, `Bytes`, `Null`. This package's `Value` has fourteen shapes, because
// DuckDB has real types and the whole reason 01.2 chose it was to keep them. So
// the conversion is total in one direction and partial in the other: every
// `SqlValue` becomes a `Value`, while a `Value` carrying a timestamp, a UUID or
// an exact decimal has no `SqlValue` to become. Callers who need those bind
// through `Statement.@bind` directly.
//
// The numeric mapping is chosen to be lossless and round-trip symmetric with the
// READ path of `duckdb.nv`, not merely to compile: signed integers widen into
// `Value.Int(i64)` exactly as a TINYINT..BIGINT column reads back; `U8`..`U32`
// become `Value.UInt(u64)`, the shape an unsigned column reads back as; `F32`
// widens into `Value.Real(f64)` exactly (every f32 is an f64). `u64` and `uint`
// have no `SqlValue` variant at all — №1637 makes `${..}` on them a compile
// error — so the adapter never sees what DuckDB would have to store as UBIGINT.

module duckdb.sqltag

import duckdb.{QueryResult, DuckError}
import duckdb.types.{Value}
import std.data.sql.{Sql, SqlValue}

/// One `SqlValue` as the parameter this package binds.
///
/// Every variant is named — no `_` arm — so a new `SqlValue` shape breaks this
/// match at compile time instead of silently binding the wrong thing (the D65
/// amendment behind E_MATCH_NON_EXHAUSTIVE, registry №703). `Bytes` becomes
/// `Value.Bytes` and therefore a BLOB, not a string: the two are different
/// columns in DuckDB and guessing from content would be worse than either.
export fn value_of(v SqlValue) -> Value {
    match v {
        SqlValue.Int(n) => Value.Int(n as i64)
        SqlValue.I8(n) => Value.Int(n as i64)
        SqlValue.I16(n) => Value.Int(n as i64)
        SqlValue.I32(n) => Value.Int(n as i64)
        SqlValue.I64(n) => Value.Int(n)
        SqlValue.U8(n) => Value.UInt(n as u64)
        SqlValue.U16(n) => Value.UInt(n as u64)
        SqlValue.U32(n) => Value.UInt(n as u64)
        SqlValue.F32(x) => Value.Real(x as f64)
        SqlValue.F64(x) => Value.Real(x)
        SqlValue.Text(s) => Value.Text(s)
        SqlValue.Bool(b) => Value.Bool(b)
        SqlValue.Bytes(b) => Value.Bytes(b)
        SqlValue.Null => Value.Null
    }
}

export fn values_of(args []SqlValue) -> []Value {
    mut out = []Value.new()
    for a in args { out.push(value_of(a)) }
    out
}

/// Prepare, bind and run a fragment in one call.
///
/// The statement is finalised before returning, including on the way out through a
/// failure — a prepared statement left behind on an error path is a leak that only
/// shows up under load, which is where it is hardest to find.
export fn Connection @run(q Sql) -> Result[QueryResult, DuckError] {
    // CONSUME-SCOPE, not `consume` + `defer { st.finalize() }`.
    //
    // This comment used to say defer was "the only spelling that actually keeps
    // that promise". It was wrong, and wrong in a way that corrupted the heap: a
    // bare `consume X = e` already gets auto-@cleanup (D432), Statement's cleanup
    // IS finalize(), so the defer called it a SECOND time. ddb_stmt_free is not
    // idempotent -- 0xC0000374, process dead. Measured 2026-09-08, both ways, in
    // claude-limits probes/duckdb-prepare-heap-corruption.
    //
    // The scope form keeps the promise the doc line above makes -- the statement is
    // finalised on every way out, failure included -- and frees exactly once.
    //
    // The result is NOT bound to a name: it is the return value, and binding it
    // would oblige this function to cover its error path too, for an object the
    // CALLER owns. Handing it back straight from `execute()` says that plainly.
    consume st = @prepare(q.template)? {
        st.bind(values_of(q.args))?
        return st.execute()
    }
}

/// The same for a statement with nothing to return: rows changed.
///
/// Here the result IS owned by this function, so it is bound and deferred -- the
/// difference between the two bodies is exactly the difference in who owns what.
export fn Connection @run_exec(q Sql) -> Result[int, DuckError] {
    consume st = @prepare(q.template)? {
        st.bind(values_of(q.args))?
        consume r = st.execute()? {
            return Ok(r.rows())
        }
    }
}
